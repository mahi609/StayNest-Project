<% if (success && success.length) { %>
  <div class="alert alert-success offset-3 col-6 alert-dismissible fade show">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="alert alert-danger offset-3 col-6 alert-dismissible fade show">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
