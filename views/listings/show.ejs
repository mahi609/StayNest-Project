<% layout("/layouts/boilerplate.ejs") -%>
<script>
  const maptoken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listings) %>;
</script>
<script>
  window.RAZORPAY_KEY = "<%= process.env.RAZORPAY_KEY_ID %>";
</script>
<body>

<div class="card shadow-lg rounded-4 border-0 mx-auto" style="width: 40rem;">

  <!-- Image -->
  <img src="<%= listings.img %>" 
       class="card-img-top rounded-top-4" 
       alt="listings img" 
       style="height: 22rem; object-fit: cover;">

  <!-- Body -->
  <div class="card-body">
    <ul class="list-unstyled mb-4">
      <li><b>OwnBy:</b> <%= listings.owner.username %></li>
      <li><b>Title:</b> <%= listings.title %></li>
      <li><b>Description:</b> <%= listings.description %></li>
      <li><b>Price:</b> ₹<%= listings.price.toLocaleString("en-IN") %></li>
      <li><b>Location:</b> <%= listings.location %></li>
      <li><b>Country:</b> <%= listings.country %></li>
    </ul>


<!-- PAY BUTTON -->
<% if (currUser) { %>
<div class="d-flex justify-content-center my-4">
  <button
    id="payBtn"
    data-listing-id="<%= listings._id %>"
    class="btn btn-primary btn-lg d-flex align-items-center gap-2 px-4 shadow"
  >
    <img src="https://razorpay.com/assets/razorpay-logo.svg" height="18">
    <span class="fw-semibold">Pay Securely</span>
  </button>
</div>
<% } %>




  </div>

   <!-- OWNER BUTTONS -->
  
    <div class="card-footer bg-white d-flex justify-content-between border-0">
      <a href="/listings/<%= listings._id %>/edit" class="btn btn-outline-primary">
        <i class="fa-solid fa-pen-to-square"></i> Edit
      </a>

      <form method="POST" action="/listings/<%= listings._id %>?_method=DELETE" class="m-0">
        <button class="btn btn-outline-danger">
          <i class="fa-solid fa-trash"></i> Delete
        </button>
      </form>
    </div>


</div>

<hr><br><br>

<!-- REVIEW FORM -->
<% if (currUser) { %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow-sm">
        <div class="card-body p-3">

          <h6 class="text-center fw-semibold mb-3">Leave a Review</h6>

          <form action="/listings/<%= listings._id %>/review"
                method="POST"
                class="needs-validation"
                novalidate>

            <!-- <div class="mb-3 text-center">
              <label class="form-label mb-2">Rating</label>
              <input type="range" class="form-range"
                     name="review[rating]" min="1" max="5" required>
            </div> -->
            <div  class="mb-3 text-center">
                <label class="form-label mb-2">Rating</label>
              <fieldset class="starability-slot">
  <legend>First rating:</legend>
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>

            </div>

            <div class="form-floating mb-3">
              <textarea class="form-control"
                        name="review[comment]"
                        id="comment"
                        style="height: 90px"
                        required></textarea>
              <label for="comment">Your experience</label>
            </div>

            <div class="d-grid">
              <button class="btn btn-success btn-sm">Submit Review</button>
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</div>
<% } %>

<br>

<!-- REVIEWS -->
<div class="row g-3 col-6 offset-3">
<% for (let review of listings.reviews) { %>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm h-100 border-0">

      <div class="card-body">
        <h6 class="fw-semibold">@<%= review.author.username %></h6>

        <% for(let i=1;i<=5;i++){ %>
          <% if(i<=review.rating){ %>
            <i class="fa-solid fa-star text-warning"></i>
          <% } else { %>
            <i class="fa-regular fa-star"></i>
          <% } %>
        <% } %>

        <p class="text-secondary mt-2"><%= review.comment %></p>
      </div>

      <div class="card-footer bg-white border-0 text-end">
        <form action="/listings/<%= listings._id %>/review/<%= review._id %>?_method=DELETE" method="POST">
          <button class="btn btn-sm btn-outline-danger">
            <i class="fa-solid fa-trash"></i>
          </button>
        </form>
      </div>

    </div>
  </div>
<% } %>
<hr>
<div class="col-6 offset-1">
  <h2>Where are you</h2>
  <div id="map"></div>
  <br><br>
</div>
</div>
<!-- RAZORPAY SCRIPT  -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script src="/js/map.js"></script>
<script src="/js/razorpay.js"></script>



</body>
